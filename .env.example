# ============================================================================
# FRONTEND - Marketplace Link (React + Vite)
# Copia este archivo a .env y ajusta los valores. NO subas el .env real.
# ============================================================================

# URL del backend (API REST)
# - Desarrollo local:  http://localhost:8080
# - Producción (VPS):  https://midominio.com/api   (o el dominio del backend)
VITE_API_URL=http://localhost:8080

# URL pública del propio frontend (para redirects, metadatos, etc.)
VITE_FRONTEND_URL=http://localhost:5174

# Puerto publicado del contenedor del frontend (Docker)
FRONT_PORT=5174

# Configuración de subida de imágenes (límites en el cliente)
VITE_MAX_FILE_SIZE=5242880
VITE_MAX_FILES=5

# Entorno
VITE_NODE_ENV=development
